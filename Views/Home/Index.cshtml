@{
    ViewData["Title"] = "Welcome to QuizMaster";
}

<div class="welcome-container d-flex align-items-center justify-content-center">
    <div class="text-center text-white p-5 shadow-lg rounded-4 glass-morphism">
        <h1 class="display-3 fw-bold mb-3">QuizMaster</h1>
        <p class="lead mb-4">Challenge your brain, climb the leaderboard, and win!</p>

        <div class="d-grid gap-3 d-sm-block">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg px-5 fw-bold me-sm-2">
                Login to Play
            </a>

            <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg px-5">
                Learn More
            </a>
        </div>
    </div>
</div>

<style>
    /* Full-screen blue gradient background */
    body {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        height: 100vh;
        margin: 0;
    }

    /* Centers the content vertically and horizontally */
    .welcome-container {
        min-height: 80vh;
    }

    /* "Glass" effect for the container */
    .glass-morphism {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Animation for the title */
    h1 {
        text-shadow: 2px 4px 10px rgba(0,0,0,0.3);
        animation: fadeInDown 1s ease-out;
    }

    @@keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>