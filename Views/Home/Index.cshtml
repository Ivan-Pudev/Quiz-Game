@{
    ViewData["Title"] = "Welcome to QuizMaster";
}

<div class="welcome-container d-flex align-items-center justify-content-center">
    <div class="text-center text-white p-5 shadow-lg rounded-4 glass-morphism">
        <h1 class="display-3 fw-bold mb-3">QuizGame</h1>
        <p class="lead mb-4">Challenge your brain, climb the leaderboard, and win!</p>

        <div class="d-grid gap-3 col-10 mx-auto">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Play"
                   asp-action="Index"
                   class="btn btn-light btn-lg fw-bold shadow-sm">
                    Join Now
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-light btn-lg fw-bold shadow-sm">
                    Join Now
                </a>
            }
        </div>
    </div>
</div>

<style>
    /* Full-screen blue gradient background */
    body {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        height: 100vh;
        margin: 0;
        overflow: hidden; /* Prevents scrollbars on a clean landing page */
    }

    .welcome-container {
        min-height: 90vh;
    }

    /* Glass effect */
    .glass-morphism {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        max-width: 500px;
    }

    /* Button hover transition */
    .btn {
        transition: transform 0.2s ease;
    }

        .btn:hover {
            transform: scale(1.02);
        }

    h1 {
        text-shadow: 2px 4px 10px rgba(0,0,0,0.3);
    }
</style>