@model IEnumerable<LeaderboardRowVm>

@{
    ViewData["Title"] = "Leaderboard";

    var rows = Model?.ToList() ?? new List<LeaderboardRowVm>();
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">🏆 Leaderboard</h1>
        <p class="text-muted">Top players ranked by score</p>
    </div>

    <div class="card shadow-lg rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Rank</th>
                        <th>Player</th>
                        <th class="text-center">Score</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rows.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No leaderboard entries yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in rows)
                        {
                            <tr class="@(row.Rank <= 3 ? "table-warning fw-bold" : "")">
                                <td class="text-center">
                                    @(row.Rank == 1 ? "🥇" :
                                                                row.Rank == 2 ? "🥈" :
                                                                row.Rank == 3 ? "🥉" :
                                                                row.Rank.ToString())
                                </td>
                                <td>@row.UserName</td>
                                <td class="text-center">@row.Score</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 text-center">
        <a asp-controller="Leaderboards" asp-action="Index" class="btn btn-outline-secondary">
            Back to Leaderboards
        </a>
    </div>
</div>
