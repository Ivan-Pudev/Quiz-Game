@model List<LeaderboardRowVm>?

<h2>Leaderboard</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Rank</th>
            <th>User</th>
            <th>Score</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Rank</td>
                <td>@r.UserName</td>
                <td>@r.Score</td>
            </tr>
        }
    </tbody>
</table>
