@model DetailsQuizViewModel

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Quizzes</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>

            <div class="card shadow-sm mb-4 border-left-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h1 class="display-5 text-primary">@Model.Title</h1>
                    </div>
                    <p class="lead text-muted">@Model.Description</p>
                    <hr />
                    <div class="row text-center">
                        <div class="col-md-4">
                            <strong>Start Time:</strong> <br /> @Model.StartTime.ToString("f")
                        </div>
                        <div class="col-md-4">
                            <strong>Question Count:</strong> <br /> @Model.Questions.Count
                        </div>
                        <div class="col-md-4">
                            <strong>Total Points:</strong> <br /> @Model.TotalPoints
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="mb-3">Questions in this Quiz</h3>

            @* @foreach (var question in Model.Questions.OrderBy(q => q.Complexity))
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between">
                        <span class="fw-bold">Question @(Model.Questions.ToList().IndexOf(question) + 1)</span>
                        <span class="badge bg-secondary">@question.Points pts</span>
                    </div>
                    <div class="card-body">
                        <p class="card-text fs-5">@question.Content</p>

                        <div class="list-group">
                            @if (question.Categories != null && question.Categories.Any())
                            {
                                <div class="mb-3">
                                    @foreach (var category in question.Categories)
                                    {
                                        <span class="badge bg-info me-1">@category.Name</span>
                                    }
                                </div>
                            }

                            <div class="list-group">
                                @foreach (var answer in question.Answers)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        @answer.Content

                                        @if (answer.IsCorrect)
                                        {
                                            <span class="badge bg-success rounded-pill">
                                                Correct Answer
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
 *@
            @{
                var orderedQuestions = Model.Questions
                .OrderBy(q => q.Complexity)
                .ToList();
            }

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var question = orderedQuestions[i];

                var categoryText = (question.Categories != null && question.Categories.Any())
                ? string.Join(", ", question.Categories.Select(c => c.Name))
                : "No categories";

                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">
                            Question @(i + 1)
                            <span class="text-muted">(@categoryText)</span>
                        </span>

                        <span class="badge bg-secondary">@question.Points pts</span>
                    </div>

                    <div class="card-body">
                        <p class="card-text fs-5 mb-3">@question.Content</p>

                        @if (question.Answers != null && question.Answers.Any())
                        {
                            <div class="list-group">
                                @foreach (var answer in question.Answers)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        @answer.Content
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No answers added yet.</p>
                        }
                    </div>
                </div>
            }

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Quiz</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <a asp-action="Leaderboard" asp-route-id="@Model.Id" class="btn btn-info">Leaderboard</a>
            </div>
        </div>
    </div>
</div>
