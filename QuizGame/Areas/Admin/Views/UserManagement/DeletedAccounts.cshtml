@model IEnumerable<AdminUserViewModel>

@{
    ViewData["Title"] = "Deleted Accounts";
    Layout = "_Layout";
}

<style>
    :root {
        --blue:       #2563eb;
        --blue-dark:  #1d4ed8;
        --blue-light: #eff6ff;
        --black:      #111111;
        --gray:       #6b7280;
        --gray-light: #9ca3af;
        --border:     #d1d5db;
        --bg:         #f9fafb;
        --white:      #ffffff;
        --danger:     #dc2626;
        --danger-bg:  #fef2f2;
        --success:    #16a34a;
        --success-bg: #f0fdf4;
    }

    /* ── Page header ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 2rem 0 1.5rem;
    }

    .page-header-left { display: flex; align-items: center; gap: .75rem; }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .875rem;
        color: var(--gray);
        text-decoration: none;
        padding: .35rem .65rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--white);
        transition: border-color .15s, color .15s;
    }
    .back-btn:hover { border-color: var(--blue); color: var(--blue); }

    .page-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--black); }
    .page-header .subtitle { font-size: .875rem; color: var(--gray); margin-top: .25rem; }

    /* ── Stats bar ── */
    .stats-bar { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .75rem 1.25rem;
        min-width: 130px;
    }
    .stat-card .stat-label {
        font-size: .75rem;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: .05em;
        font-weight: 500;
    }
    .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; margin-top: .15rem; }
    .stat-card .stat-value.danger { color: var(--danger); }

    /* ── Alert ── */
    .alert {
        border-radius: 6px;
        padding: .75rem 1rem;
        font-size: .875rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .alert-success { background: var(--success-bg); color: var(--success); border: 1px solid #bbf7d0; }
    .alert-danger  { background: var(--danger-bg);  color: var(--danger);  border: 1px solid #fecaca; }

    /* ── Toolbar ── */
    .toolbar {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 6px 6px 0 0;
        border-bottom: none;
        padding: .875rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .toolbar-left { display: flex; align-items: center; gap: .5rem; flex: 1; min-width: 180px; }

    .search-wrap { position: relative; flex: 1; max-width: 320px; }
    .search-wrap svg {
        position: absolute;
        left: .7rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--gray-light);
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        padding: .5rem .75rem .5rem 2.25rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: .875rem;
        color: var(--black);
        background: var(--white);
        transition: border-color .15s;
    }
    .search-input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(37,99,235,.15);
        outline: none;
    }

    /* ── Buttons ── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .5rem 1rem;
        border-radius: 4px;
        font-size: .875rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: background .15s, border-color .15s, color .15s;
        white-space: nowrap;
    }
    .btn-outline {
        background: var(--white);
        border: 1px solid var(--border);
        color: var(--black);
    }
    .btn-outline:hover { border-color: var(--blue); color: var(--blue); }

    .btn-sm { padding: .35rem .7rem; font-size: .8rem; }

    .btn-restore {
        background: var(--white);
        border: 1px solid var(--border);
        color: var(--success);
    }
    .btn-restore:hover { background: var(--success-bg); border-color: var(--success); }

    .btn-delete-ghost {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--danger);
    }
    .btn-delete-ghost:hover { background: var(--danger-bg); border-color: var(--danger); }

    /* ── Table ── */
    .table-wrap {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 0 0 6px 6px;
        overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; font-size: .875rem; }

    thead th {
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        padding: .75rem 1rem;
        text-align: left;
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--gray);
        white-space: nowrap;
    }

    tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background .1s;
    }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--danger-bg); }

    td { padding: .75rem 1rem; vertical-align: middle; }

    /* ── User cell ── */
    .user-cell { display: flex; align-items: center; gap: .75rem; }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--gray-light);
        color: var(--white);
        font-size: .8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .user-email { font-weight: 500; color: var(--black); text-decoration: line-through; text-decoration-color: var(--gray-light); }
    .user-id    { font-size: .75rem; color: var(--gray-light); font-family: ui-monospace, monospace; margin-top: .1rem; }

    /* ── Banned badge ── */
    .badge-banned {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 500;
        background: var(--danger-bg);
        color: var(--danger);
        border: 1px solid #fecaca;
    }

    /* ── Roles cell ── */
    .roles-cell { display: flex; flex-wrap: wrap; gap: .35rem; }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: .2rem .55rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 500;
        line-height: 1;
    }
    .badge-admin     { background: #fffbeb; color: #92400e; }
    .badge-moderator { background: #f0fdf9; color: #0f6e56; }
    .badge-user      { background: var(--blue-light); color: var(--blue-dark); }
    .badge-default   { background: #f3f4f6; color: var(--gray); }

    /* ── Actions cell ── */
    .actions-cell { display: flex; gap: .4rem; }

    /* ── Empty state ── */
    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--gray); }
    .empty-state svg { margin-bottom: .75rem; color: var(--gray-light); }
    .empty-state p { font-size: .875rem; }

    /* ── Pagination bar ── */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .875rem 1rem;
        border-top: 1px solid var(--border);
        font-size: .8rem;
        color: var(--gray);
        flex-wrap: wrap;
        gap: .5rem;
    }
</style>

<!-- Page header -->
<div class="page-header">
    <div class="page-header-left">
        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="back-btn">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back
        </a>
        <div>
            <h1>Deleted Accounts</h1>
            <p class="subtitle">Review and manage deleted users.</p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M20 6L9 17l-5-5"/>
        </svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Stats -->
<div class="stats-bar">
    <div class="stat-card">
        <div class="stat-label">Banned Total</div>
        <div class="stat-value danger">@Model.Where(u=>u.IsDeleted).Count()</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Admins Banned</div>
        <div class="stat-value">@Model.Where(u=>u.IsDeleted).Count(u => u.Roles.Contains("Admin"))</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Moderators Banned</div>
        <div class="stat-value">@Model.Where(u=>u.IsDeleted).Count(u => u.Roles.Contains("Moderator"))</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Players Banned</div>
        <div class="stat-value">@Model.Where(u=>u.IsDeleted).Count(u => !u.Roles.Any() || u.Roles.All(r => r == "User"))</div>
    </div>
</div>

<!-- Toolbar -->
<div class="toolbar">
    <div class="toolbar-left">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input id="searchInput"
                   class="search-input"
                   type="search"
                   placeholder="Search by email or ID…"
                   oninput="filterTable()" />
        </div>
    </div>
    <button class="btn btn-outline" onclick="window.location.reload()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Refresh
    </button>
</div>

<!-- Table -->
<div class="table-wrap">
    @if (!Model.Any(u=>u.IsDeleted))
    {
        <div class="empty-state">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
            <p>No banned accounts found.</p>
        </div>
    }
    else
    {
        <table id="bannedTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Status</th>
                    <th>Roles</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var initials = user.Email?.Length >= 2
                        ? user.Email.Substring(0, 2).ToUpper()
                        : user.Email?.ToUpper() ?? "??";

                    <tr data-email="@user.Email?.ToLower()">
                        <td>
                            <div class="user-cell">
                                <div class="avatar">@initials</div>
                                <div>
                                    <div class="user-email">@user.Email</div>
                                    <div class="user-id">@user.Id</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-banned">
                                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                </svg>
                                Banned
                            </span>
                        </td>
                        <td>
                            <div class="roles-cell">
                                @if (!user.Roles.Any())
                                {
                                    <span class="badge badge-default">No roles</span>
                                }
                                else
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        var cls = role switch {
                                            "Admin"     => "badge-admin",
                                            "Moderator" => "badge-moderator",
                                            "User"      => "badge-user",
                                            _           => "badge-default"
                                        };
                                        <span class="badge @cls">@role</span>
                                    }
                                }
                            </div>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <!-- Restore -->
                                <form asp-area="Admin"
                                      asp-controller="UserManagement"
                                      asp-action="Restore"
                                      method="post"
                                      onsubmit="return confirm('Restore access for @Html.Raw(user.Email)?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-restore btn-sm">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                            <polyline points="23 4 23 10 17 10"/>
                                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                                        </svg>
                                        Restore
                                    </button>
                                </form>

                                <!-- Permanent delete -->
                                <form asp-area="Admin"
                                      asp-controller="User"
                                      asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Permanently delete @Html.Raw(user.Email)? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-delete-ghost btn-sm">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14H6L5 6"/>
                                            <path d="M10 11v6M14 11v6"/>
                                            <path d="M9 6V4h6v2"/>
                                        </svg>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span id="resultCount">Showing @Model.Count() banned account(s)</span>
        </div>
    }
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase().trim();
        const rows   = document.querySelectorAll('#bannedTable tbody tr');
        let visible  = 0;

        rows.forEach(row => {
            const email = row.dataset.email || '';
            const show  = !search || email.includes(search);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const countEl = document.getElementById('resultCount');
        if (countEl) countEl.textContent = `Showing ${visible} banned account(s)`;
    }
</script>

