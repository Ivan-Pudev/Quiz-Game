@model IEnumerable<Leaderboard>

@{
    ViewData["Title"] = "Leaderboards";
}

<div class="container mt-4">
    <h2 class="mb-4">Quiz Leaderboards</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No leaderboards available yet.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Quiz</th>
                    <th>Description</th>
                    <th>Last Updated</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Leaderboard leaderboard in Model)
                {
                    <tr>
                        <td class="fw-bold">
                            @leaderboard.Quiz.Title
                        </td>

                        <td>
                            @leaderboard.Quiz.Description
                        </td>

                        <td>
                            @leaderboard.LastUpdated.ToString("dd MMM yyyy")
                        </td>

                        <td class="text-end">
                            <a asp-controller="Leaderboard"
                               asp-action="Details"
                               asp-route-id="@leaderboard.Id"
                               class="btn btn-sm btn-primary">
                                View Rankings
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
