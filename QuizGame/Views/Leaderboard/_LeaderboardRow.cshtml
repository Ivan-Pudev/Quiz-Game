@model AdminLeaderboardViewModel
<tr data-title="@Model.Title.ToLower()"
    data-id="@Model.Id.ToString().ToLower()"
    data-quiz="@Model.QuizTitle.ToLower()">

    <!-- Title + ID -->
    <td>
        <div class="lb-cell">
            <div class="lb-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path d="M8 2v12M4 6v8M12 4v10" />
                </svg>
            </div>
            <div>
                <div class="lb-title">@Model.Title</div>
                <div class="lb-id">@Model.Id</div>
            </div>
        </div>
    </td>

    <!-- Description -->
    <td>
        <div class="desc-text" title="@Model.Description">@Model.Description</div>
    </td>

    <!-- Linked quiz -->
    <td>
        <a asp-area=""
               asp-controller="Quiz"
               asp-action="Edit"
               asp-route-id="@Model.QuizId"
               class="quiz-link"
               title="@Model.QuizTitle">
            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M7 8h10M7 12h10M7 16h5" />
            </svg>
            @Model.QuizTitle
        </a>
    </td>

    <!-- Entries -->
    <td>
        <span class="entries-badge">
            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            @Model.EntryCount
        </span>
    </td>

    <!-- Last updated -->
    <td>
        <div class="date-text">@Model.LastUpdated.ToString("dd MMM yyyy")</div>
    </td>

    <!-- Actions -->
    <td>
        <div class="actions-cell">

            <!-- View entries -->
            <a asp-area=""
                   asp-controller="Leaderboard"
                   asp-action="Rankings"
                   asp-route-id="@Model.Id"
                   class="btn btn-view btn-sm"
                   title="View entries">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                View
            </a>

            <!-- Edit -->
            <a asp-area=""
                   asp-controller="Leaderboard"
                   asp-action="ManageEntries"
                   asp-route-id="@Model.Id"
                   class="btn btn-edit btn-sm"
                   title="Edit leaderboard">
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
                Edit
            </a>
        </div>
    </td>

</tr>
