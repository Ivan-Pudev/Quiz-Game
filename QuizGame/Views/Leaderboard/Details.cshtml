@model IEnumerable<AdminLeaderboardViewModel>

@{
    ViewData["Title"] = "Leaderboard Management";
    Layout = "_Layout";
}

<style>
    :root {
        --blue:       #2563eb;
        --blue-dark:  #1d4ed8;
        --blue-light: #eff6ff;
        --black:      #111111;
        --gray:       #6b7280;
        --gray-light: #9ca3af;
        --border:     #d1d5db;
        --bg:         #f9fafb;
        --white:      #ffffff;
        --danger:     #dc2626;
        --danger-bg:  #fef2f2;
        --success:    #16a34a;
        --success-bg: #f0fdf4;
        --amber:      #d97706;
        --amber-bg:   #fffbeb;
        --teal:       #0d9488;
        --teal-bg:    #f0fdf9;
    }

    /* ── Page header ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin: 2rem 0 1.5rem;
    }
    .page-header h1      { font-size: 1.75rem; font-weight: 700; color: var(--black); }
    .page-header .subtitle { font-size: .875rem; color: var(--gray); margin-top: .25rem; }

    /* ── Alerts ── */
    .alert {
        border-radius: 6px;
        padding: .75rem 1rem;
        font-size: .875rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .alert-success { background: var(--success-bg); color: var(--success); border: 1px solid #bbf7d0; }
    .alert-danger  { background: var(--danger-bg);  color: var(--danger);  border: 1px solid #fecaca; }

    /* ── Stats bar ── */
    .stats-bar { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: .75rem 1.25rem;
        min-width: 130px;
    }
    .stat-card .stat-label {
        font-size: .75rem;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: .05em;
        font-weight: 500;
    }
    .stat-card .stat-value         { font-size: 1.5rem; font-weight: 700; margin-top: .15rem; }
    .stat-card .stat-value.amber   { color: var(--amber); }
    .stat-card .stat-value.teal    { color: var(--teal); }
    .stat-card .stat-value.success { color: var(--success); }

    /* ── Toolbar ── */
    .toolbar {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 6px 6px 0 0;
        border-bottom: none;
        padding: .875rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        flex-wrap: wrap;
    }
    .toolbar-left { display: flex; align-items: center; gap: .5rem; flex: 1; min-width: 180px; }

    .search-wrap { position: relative; flex: 1; max-width: 320px; }
    .search-wrap svg {
        position: absolute;
        left: .7rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--gray-light);
        pointer-events: none;
    }
    .search-input {
        width: 100%;
        padding: .5rem .75rem .5rem 2.25rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        font-size: .875rem;
        color: var(--black);
        background: var(--white);
        transition: border-color .15s;
    }
    .search-input:focus {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(37,99,235,.15);
        outline: none;
    }

    /* ── Buttons ── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .5rem 1rem;
        border-radius: 4px;
        font-size: .875rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: background .15s, border-color .15s, color .15s;
        white-space: nowrap;
    }
    .btn-primary { background: var(--blue); color: var(--white); }
    .btn-primary:hover { background: var(--blue-dark); }

    .btn-outline {
        background: var(--white);
        border: 1px solid var(--border);
        color: var(--black);
    }
    .btn-outline:hover { border-color: var(--blue); color: var(--blue); }

    .btn-sm { padding: .35rem .7rem; font-size: .8rem; }

    .btn-view {
        background: var(--white);
        border: 1px solid var(--border);
        color: var(--teal);
    }
    .btn-view:hover { background: var(--teal-bg); border-color: var(--teal); }

    .btn-edit {
        background: var(--white);
        border: 1px solid var(--border);
        color: var(--black);
    }
    .btn-edit:hover { border-color: var(--blue); color: var(--blue); }

    .btn-delete-ghost {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--danger);
    }
    .btn-delete-ghost:hover { background: var(--danger-bg); border-color: var(--danger); }

    /* ── Table ── */
    .table-wrap {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 0 0 6px 6px;
        overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; font-size: .875rem; }

    thead th {
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        padding: .75rem 1rem;
        text-align: left;
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--gray);
        white-space: nowrap;
    }

    tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--blue-light); }

    td { padding: .75rem 1rem; vertical-align: middle; }

    /* ── Leaderboard cell ── */
    .lb-cell { display: flex; align-items: center; gap: .75rem; }

    .lb-icon {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        background: var(--amber-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--amber);
    }

    .lb-title { font-weight: 500; color: var(--black); }
    .lb-id    { font-size: .73rem; color: var(--gray-light); font-family: ui-monospace, monospace; margin-top: .1rem; }

    /* ── Quiz link ── */
    .quiz-link {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .8rem;
        color: var(--blue);
        text-decoration: none;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .quiz-link:hover { text-decoration: underline; }

    /* ── Description ── */
    .desc-text {
        font-size: .8rem;
        color: var(--gray);
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Date ── */
    .date-text { font-size: .8rem; color: var(--gray); white-space: nowrap; }

    /* ── Entries badge ── */
    .entries-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .6rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 500;
        background: var(--amber-bg);
        color: var(--amber);
        border: 1px solid #fde68a;
    }

    /* ── Actions cell ── */
    .actions-cell { display: flex; gap: .4rem; flex-wrap: wrap; }

    /* ── Empty state ── */
    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--gray); }
    .empty-state svg { margin-bottom: .75rem; color: var(--gray-light); }
    .empty-state p { font-size: .875rem; }

    /* ── Pagination bar ── */
    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .875rem 1rem;
        border-top: 1px solid var(--border);
        font-size: .8rem;
        color: var(--gray);
        flex-wrap: wrap;
        gap: .5rem;
    }
</style>

<!-- Page header -->
<div class="page-header">
    <div>
        <h1>Leaderboard Management</h1>
        <p class="subtitle">View, edit, and manage all quiz leaderboards.</p>
    </div>
    <a asp-area="" asp-controller="Leaderboard" asp-action="GlobalLeaderboard" class="btn btn-primary">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        View Global Leaderboard
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M20 6L9 17l-5-5"/>
        </svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Stats -->
@{
    var total        = Model.Count();
    var totalEntries = Model.Sum(l => l.EntryCount);
    var updatedToday = Model.Count(l => l.LastUpdated == DateOnly.FromDateTime(DateTime.UtcNow));
    var avgEntries   = total > 0 ? (double)totalEntries / total : 0;
}
<div class="stats-bar">
    <div class="stat-card">
        <div class="stat-label">Total Leaderboards</div>
        <div class="stat-value">@total</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Entries</div>
        <div class="stat-value amber">@totalEntries</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Updated Today</div>
        <div class="stat-value success">@updatedToday</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Avg Entries</div>
        <div class="stat-value teal">@avgEntries.ToString("F1")</div>
    </div>
</div>

<!-- Toolbar -->
<div class="toolbar">
    <div class="toolbar-left">
        <div class="search-wrap">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input id="searchInput"
                   class="search-input"
                   type="search"
                   placeholder="Search by title, quiz or ID…"
                   oninput="filterTable()" />
        </div>
    </div>
    <button class="btn btn-outline" onclick="window.location.reload()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Refresh
    </button>
</div>

<!-- Table -->
<div class="table-wrap">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M8 2v12M4 6v8M12 4v10"/>
                <rect x="1" y="14" width="22" height="8" rx="1"/>
            </svg>
            <p>No leaderboards found. Create one to get started.</p>
        </div>
    }
    else
    {
        <table id="lbTable">
            <thead>
                <tr>
                    <th>Leaderboard</th>
                    <th>Description</th>
                    <th>Linked Quiz</th>
                    <th>Entries</th>
                    <th>Last Updated</th>
                    <th style="width:190px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lb in Model)
                {
                    <tr data-title="@lb.Title.ToLower()"
                        data-id="@lb.Id.ToString().ToLower()"
                        data-quiz="@lb.QuizTitle.ToLower()">

                        <!-- Title + ID -->
                        <td>
                            <div class="lb-cell">
                                <div class="lb-icon">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                        <path d="M8 2v12M4 6v8M12 4v10"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="lb-title">@lb.Title</div>
                                    <div class="lb-id">@lb.Id</div>
                                </div>
                            </div>
                        </td>

                        <!-- Description -->
                        <td>
                            <div class="desc-text" title="@lb.Description">@lb.Description</div>
                        </td>

                        <!-- Linked quiz -->
                        <td>
                            <a asp-area=""
                               asp-controller="Quiz"
                               asp-action="Edit"
                               asp-route-id="@lb.QuizId"
                               class="quiz-link"
                               title="@lb.QuizTitle">
                                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <path d="M7 8h10M7 12h10M7 16h5"/>
                                </svg>
                                @lb.QuizTitle
                            </a>
                        </td>

                        <!-- Entries -->
                        <td>
                            <span class="entries-badge">
                                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                                @lb.EntryCount
                            </span>
                        </td>

                        <!-- Last updated -->
                        <td>
                            <div class="date-text">@lb.LastUpdated.ToString("dd MMM yyyy")</div>
                        </td>

                        <!-- Actions -->
                        <td>
                            <div class="actions-cell">

                                <!-- View entries -->
                                <a asp-area=""
                                   asp-controller="Leaderboard"
                                   asp-action="Rankings"
                                   asp-route-id="@lb.Id"
                                   class="btn btn-view btn-sm"
                                   title="View entries">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    View
                                </a>

                                <!-- Edit -->
                                <a asp-area=""
                                   asp-controller="Leaderboard"
                                   asp-action="ManageEntries"
                                   asp-route-id="@lb.Id"
                                   class="btn btn-edit btn-sm"
                                   title="Edit leaderboard">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                    Edit
                                </a>

                                <!-- Delete -->
                                @* <form asp-area=""
                                      asp-controller="Leaderboard"
                                      asp-action="DeleteEntries"
                                      method="post"
                                      onsubmit="return confirm('Delete leaderboard \'@Html.Raw(lb.Title)\'? This will also remove all entries.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@lb.Id" />
                                    <button type="submit" class="btn btn-delete-ghost btn-sm" title="Delete leaderboard">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6l-1 14H6L5 6"/>
                                            <path d="M10 11v6M14 11v6"/>
                                            <path d="M9 6V4h6v2"/>
                                        </svg>
                                        Delete
                                    </button>
                                </form> *@

                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-bar">
            <span id="resultCount">Showing @Model.Count() leaderboard(s)</span>
        </div>
    }
</div>

<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase().trim();
        const rows   = document.querySelectorAll('#lbTable tbody tr');
        let visible  = 0;

        rows.forEach(row => {
            const title = row.dataset.title || '';
            const id    = row.dataset.id    || '';
            const quiz  = row.dataset.quiz  || '';
            const show  = !search || title.includes(search) || id.includes(search) || quiz.includes(search);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        const countEl = document.getElementById('resultCount');
        if (countEl) countEl.textContent = `Showing ${visible} leaderboard(s)`;
    }
</script>

