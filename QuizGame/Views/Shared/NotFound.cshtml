@{
    ViewData["Title"] = "Not Found";
}

<link rel="stylesheet" href="~/css/NotFound.css" asp-append-version="true" />

<div class="not-found-wrapper">
    <div class="not-found-code">404</div>
    <div class="not-found-title">Page Not Found</div>
    <hr class="not-found-divider" />
    <div class="not-found-alert">
        The page you are looking for does not exist or may have been moved.
    </div>
    <p class="not-found-message">
        Double-check the URL or head back to the home page.
    </p>
    <a href="/" class="not-found-btn">Go to Home</a>
</div>

