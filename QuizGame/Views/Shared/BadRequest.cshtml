@{
    ViewData["Title"] = "Bad Request";
}
<link rel="stylesheet" href="~/css/BadRequest.css" asp-append-version="true" />

<div class="bad-request-wrapper">
    <div class="bad-request-code">400</div>
    <div class="bad-request-title">Bad Request</div>
    <hr class="bad-request-divider" />
    <div class="bad-request-alert">
        The server could not understand your request. Please check your input and try again.
    </div>
    <p class="bad-request-message">
        If you believe this is a mistake, please go back or return to the home page.
    </p>
    <a href="/" class="bad-request-btn">Go to Home</a>
</div>


