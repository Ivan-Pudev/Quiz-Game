@model PlayQuestionViewModel

@{
    ViewData["Title"] = "Play Quiz";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-body">

            <h5 class="mb-3">@Model.QuestionContent</h5>

            <form asp-action="SubmitAnswer" method="post">
                <input type="hidden" name="attemptId" value="@Model.AttemptId" />
                <input type="hidden" name="questionId" value="@Model.QuestionId" />

                @foreach (var a in Model.Answers)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input"
                               type="radio"
                               name="selectedAnswerId"
                               value="@a.Id"
                               required />
                        <label class="form-check-label">@a.Content</label>
                    </div>
                }

                <button type="submit" class="btn btn-primary mt-3">Submit</button>
            </form>
        </div>
    </div>
</div>