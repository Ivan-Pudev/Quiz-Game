@model GameSummaryViewModel

@{
    ViewData["Title"] = "Game Summary";
}

@if (Model == null)
{
    <div class="container mt-4">
        <div class="alert alert-danger">
            Summary data is missing.
        </div>

        <a asp-controller="Play" asp-action="Index" class="btn btn-outline-secondary">
            Back to Play
        </a>
    </div>
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold">🎯 Game Summary</h1>
        <p class="text-muted">@Model.QuizTitle</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg rounded-4">
                <div class="card-body p-4">

                    <div class="row text-center mb-4">
                        <div class="col-md-6">
                            <h5 class="text-muted">Score</h5>
                            <h1 class="fw-bold text-primary">
                                @Model.Score / @Model.MaxScore
                            </h1>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-muted">Correct Answers</h5>
                            <h1 class="fw-bold text-success">
                                @Model.CorrectAnswers / @Model.TotalQuestions
                            </h1>
                        </div>
                    </div>

                    <hr />
                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Quiz</div>
                        <div class="col-sm-6 text-end">@Model.QuizTitle</div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-6 fw-bold">Total Questions</div>
                        <div class="col-sm-6 text-end">@Model.TotalQuestions</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Quiz ID</div>
                        <div class="col-sm-6 text-end">@Model.QuizId</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Quiz Title</div>
                        <div class="col-sm-6 text-end">@Model.QuizTitle</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Total Questions</div>
                        <div class="col-sm-6 text-end">@Model.TotalQuestions</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Correct Answers</div>
                        <div class="col-sm-6 text-end">@Model.CorrectAnswers</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Final Score</div>
                        <div class="col-sm-6 text-end">@Model.Score</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-6 fw-bold">Max Possible Score</div>
                        <div class="col-sm-6 text-end">@Model.MaxScore</div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a asp-controller="Leaderboards"
                           asp-action="Details"
                           asp-route-id="@Model.LeaderboardId"
                           class="btn btn-info btn-lg text-white">
                            🏆 View Leaderboard
                        </a>

                        <a asp-controller="Play"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">
                            Back to Play
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
